# 개발 환경
SERVER_PORT=

# DB: PostgreSQL (기본 포트 5432). 로컬은 docker-compose.local.yml 사용 권장.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

JWT_EXPIRATION_TIME=15m
JWT_SECRET_KEY=secret
JWT_REFRESH_SECRET_KEY=secret
JWT_REFRESH_EXPIRATION_TIME=7d

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=user@gmail.com
EMAIL_FROM_NAME=SnapHaven
EMAIL_PASS= # snaphaven 프로젝트 전용 app key

CLIENT_ADDRESS=http://localhost:3000

# Google Auth
GOOGLE_CLIENT_ID=

# AWS config
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AWS_REGION=
AWS_S3_ORIGINALS_BUCKET=
AWS_S3_ASSETS_BUCKET=

# Redis config
REDIS_HOST=localhost
REDIS_PORT=6379